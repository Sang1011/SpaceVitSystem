# Sao chép thành ai-service/.env và điền giá trị. KHÔNG commit file .env.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Tùy chọn: MINIMAL | LOW | MEDIUM | HIGH. Để trống = mặc định của model.
GEMINI_THINKING_LEVEL=

# Các biến dưới đây thường để compose đặt; chỉ cần khi chạy service trực tiếp trên host.
# AI_SERVICE_TOKEN=
# MEDIA_ROOT=../data/media
# STT_DEVICE=auto          # auto | cuda | cpu
# STT_BATCH=8              # 0 = tuần tự kiểu cũ; tăng dần (8, 16) tới sát giới hạn VRAM
# STT_BEAM=1
# STT_COMPUTE_TYPE=        # mặc định float16 (cuda) / int8 (cpu); int8_float16 tiết kiệm VRAM
# STT_CPU_THREADS=
# STT_VAD_THRESHOLD=0.4
# STT_VAD_PAD_MS=500
# MAX_AUDIO_SEC=7260
