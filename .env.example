POSTGRES_USER=svs
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=svs
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=5000
GEMINI_MODEL=gemini-3.5-flash-lite # Model có thể thay đổi tùy chỉnh
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Tùy chọn: MINIMAL | LOW | MEDIUM | HIGH. Để trống = mặc định của model.
GEMINI_THINKING_LEVEL=
AI_SERVICE_TOKEN=CHANGE_ME
AI_SERVICE_PORT=8000

# Thư mục media dùng chung. Mặc định ./data/media (bind mount). Đặt `media` để dùng named volume.
# MEDIA_SOURCE=./data/media
